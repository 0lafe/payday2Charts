<div
    x-show="isMyTurn"
    x-cloak
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 px-4 py-8">
    <template x-if="state.stage === 'waiting'">
        <%= render "draft_games/interaction_area/team_choice", draft_game: @draft_game %>
    </template>

    <template x-if="state.stage === 'heist_bans'">
        <%= render "draft_games/interaction_area/heist_ban", draft_game: @draft_game %>
    </template>

    <template x-if="state.stage === 'perk_bans'">
        <%= render "draft_games/interaction_area/perk_pick", draft_game: @draft_game, type: 'ban' %>
    </template>

    <template x-if="state.stage === 'perk_choices'">
        <%= render "draft_games/interaction_area/perk_pick", draft_game: @draft_game, type: 'pick' %>
    </template>

    <template x-if="state.stage === 'weapon_bans'">
        <%= render "draft_games/interaction_area/weapon_pick", draft_game: @draft_game, type: 'ban' %>
    </template>

    <template x-if="state.stage === 'skill_bans'">
        <%= render "draft_games/interaction_area/skill_pick", draft_game: @draft_game, type: 'ban' %>
    </template>

    <template x-if="state.stage === 'finish'">
        <%= render "draft_games/interaction_area/pick_winner", draft_game: @draft_game %>
    </template>
</div>
