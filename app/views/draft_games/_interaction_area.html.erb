<div
    x-data='draftGame({
        draftGameId: "<%= @draft_game.public_key %>",
        currentUserId: <%= current_user.id %>,
        initialState: <%= raw json_escape(@draft_game.client_state.to_json) %>,
        heistImages: <%= raw json_escape(
            @draft_game.base_heists.map { |heist| asset_path("heists/named/#{heist}") }.to_json
        ) %>
    })'
    x-show="isMyTurn"
    x-cloak
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 px-4 py-8"
>
    <template x-if="state.stage === 'waiting'">
        <%= render "draft_games/team_choice", draft_game: @draft_game %>
    </template>

    <template x-if="state.stage === 'heist_bans'">
        <%= render "draft_games/heist_ban", draft_game: @draft_game %>
    </template>

    <template x-if="state.stage === 'perk_bans'">
        <%= render "draft_games/perk_ban", draft_game: @draft_game %>
    </template>
</div>
