<div id="heist-bans" class="flex flex-col gap-4 w-full">
    <div class="text-center text-3xl">
        Heist Bans
    </div>

    <div class="flex justify-between">
        <% draft_game.draft_bans.heist.each do |heist_ban| %>
            <% team = heist_ban.draft_game_user.team %>

            <%= image_tag("guess_who/heists/#{heist_ban.name}", class: "w-32 h-32 rounded-md ring-2 #{team == 'team_a' ? 'ring-red-500' : 'ring-blue-500'}") %>
        <% end %>
    </div>
</div>