<%= turbo_stream_from @draft_game %>
<%= turbo_stream_from [@draft_game, current_user] %>

<%= render "draft_games/interaction_area", draft_game: @draft_game, user: current_user %>

<div class="grid grid-cols-3 gap-4 p-4 min-h-screen">
    <div class="flex flex-col justify-between">
        <div>
            <%= render "draft_games/team_list", draft_game: @draft_game, team: "team_a" %>
        </div>

        <%= render "draft_games/perkdeck_ban_list", draft_game: @draft_game %>
    </div>

    <div class="flex flex-col items-center justify-between">
        <%= render "draft_games/selected_heist", draft_game: @draft_game %>

        <%= render "draft_games/showoff_area", draft_game: @draft_game %>

        <%= render "draft_games/heist_ban_list", draft_game: @draft_game %>
    </div>

    <div class="flex flex-col">
        <div class="flex justify-end">
            <%= render "draft_games/team_list", draft_game: @draft_game, team: "team_b" %>
        </div>
    </div>
</div>