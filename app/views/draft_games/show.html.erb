<%= turbo_stream_from @draft_game %>
<%= turbo_stream_from [@draft_game, current_user] %>

<div x-data='draftGame({
    draftGameId: "<%= @draft_game.public_key %>",
    currentUserId: <%= current_user.id %>,
    initialState: <%= raw json_escape(@draft_game.client_state.to_json) %>,
    assetImages: <%= raw json_escape(
        (
            @draft_game.base_heists.map { |file| asset_path("heists/named/#{file}.png") } + 
            @draft_game.base_perkdecks.map { |file| asset_path("perkdecks/#{file}.png") } + 
            @draft_game.base_weapons.map { |file| asset_path("weapon_types/#{file}.png") } + 
            @draft_game.base_skills.map { |file| asset_path("skill_trees/#{file}.png") }
        ).to_json
    ) %>
})'>
    <div
        class="absolute inset-0 bg-center bg-cover bg-no-repeat <%= @draft_game.waiting? ? "animate-warehouse-zoom-in" : "" %>"
        style="background-image: url('<%= image_url("warehouse.jpg") %>');"
    ></div>

    <div class="grid grid-cols-3 gap-4 p-4 min-h-screen bg-black bg-center bg-cover bg-no-repeat draft-game-container tracking-wide <%= @draft_game.waiting? ? "animate-content-zoom-in" : "" %>">
        <%= render "draft_games/interaction_area", draft_game: @draft_game, user: current_user %>
        <div
            x-show="isWaitingToStart"
            x-cloak
            class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 px-4 py-8">
            <div class="flex justify-center items-center">
                Waiting for players to join game
            </div>
        </div>

        <div class="flex flex-col justify-between">
            <div class="flex justify-start">
                <%= render "draft_games/team_list", team: "team_a" %>
            </div>

            <div class="flex flex-col gap-4">
                <%= render "draft_games/skill_ban_list" %>
                <%= render "draft_games/perkdeck_ban_list" %>
            </div>
        </div>

        <div class="flex flex-col items-center justify-between gap-4">
            <%= render "draft_games/selected_heist" %>

            <%= render "draft_games/showoff_area" %>

            <%= render "draft_games/heist_ban_list" %>
        </div>

        <div class="flex flex-col justify-between">
            <div class="flex justify-end">
                <%= render "draft_games/team_list", team: "team_b" %>
            </div>

            <%= render "draft_games/weapon_ban_list" %>
        </div>
    </div>
</div>