<%= simple_form_for DraftBan.new do |f| %>
    <%= f.hidden_field :draft_game_id, value: draft_game.id %>

    <%= render DraftGameModalComponent.new do |modal| %>
        <% modal.with_header do %>
            Pick a Perkdeck to ban
        <% end %>

        <div class="grid grid-cols-4 gap-4">
            <template x-for="perkdeck in state.available_perkdecks" :key="perkdeck[0]">
                <label
                    class="cursor-pointer border rounded-lg p-4"
                    :class="{ 'ring-2': selectedPerkdeck == perkdeck[0],
                        'ring-red-500': myTeam === 'team_a',
                        'ring-blue-500': myTeam === 'team_b'
                    }"
                >
                    <input
                        type="radio"
                        name="draft_ban[name]"
                        :value="perkdeck[0]"
                        x-model="selectedPerkdeck"
                        class="hidden"
                    >

                    <span x-text="perkdeck[1]"></span>
                </label>
            </template>
        </div>

        <% modal.with_footer do %>
            <%= f.submit 'Submit', class: "btn-primary w-full mt-4 cursor-pointer" %>
        <% end %>
    <% end %>
<% end %>