<div class="flex flex-col items-center gap-4"
    x-data='showoffContent({audio: "<%= draft_pick.sound %>"})'
    x-show="show"
    x-cloak
    x-transition.opacity.duration.300ms>
    <div class="text-3xl text-center">
        <span class="font-bold <%= draft_pick.draft_game_user.team == 'team_a' ? 'text-red-500' : 'text-blue-500' %>">
            <%= draft_pick.draft_game_user.user.name %>
        </span>

        <% if draft_pick.ban? %>
            Banned
        <% else %>
            Chose
        <% end %>
    </div>

    <div class="animate-zoom-in">
        <%= image_tag("perkdecks/#{draft_pick.name}.png") %>
    </div>

    <div class="text-2xl">
        <%= draft_pick.name.titleize %>
    </div>
</div>