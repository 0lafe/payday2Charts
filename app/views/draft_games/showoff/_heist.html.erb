<div class="flex flex-col items-center gap-4 corner-border p-4"
    x-data='showoffContent({audio: "<%= draft_pick.sound %>"})'
    x-show="show"
    x-cloak
    x-transition.opacity.duration.300ms>
    <div class="text-3xl text-center">
        <span class="font-bold <%= draft_pick.draft_game_user.team == 'team_a' ? 'text-team-a' : 'text-team-b' %>">
            <%= draft_pick.draft_game_user.user.name %>
        </span>

        Banned
    </div>

    <%= image_tag("heists/named/#{draft_pick.name}.png", class: "animate-zoom-in rounded-md ring-2 ring-[#c59531]") %>
</div>