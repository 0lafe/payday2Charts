<div class="flex gap-4">
    <template x-for="playerNumber in 2" :key="playerNumber">
        <div class="flex flex-col items-center">
            <div class="rounded-full border-2 w-16 h-16 flex justify-center items-center overflow-hidden
                <%= team == 'team_a' ? 'border-red-500' : 'border-blue-500' %>">

                <template x-if="teamUsers('<%= team %>')[playerNumber - 1]">
                    <img
                        :src="teamUsers('<%= team %>')[playerNumber - 1].avatar"
                        class="w-full h-full object-cover"
                    />
                </template>

                <template x-if="!teamUsers('<%= team %>')[playerNumber - 1]">
                    <i class="fa-regular fa-user text-3xl"></i>
                </template>
            </div>

            <span
                x-show="teamUsers('<%= team %>')[playerNumber - 1]"
                x-text="teamUsers('<%= team %>')[playerNumber - 1]?.name"
            ></span>
        </div>
    </template>
</div>