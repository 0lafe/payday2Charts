<div class="min-h-32 flex flex-col gap-4 w-full ring-2 ring-[#186d98] bg-[#186d98]/40 p-4">
    <div class="text-center text-3xl text-shadow-lg text-shadow-black">
        Skill Tree Bans
    </div>

    <div class="flex justify-between">
        <template x-for="ban in skillBans('team_a')">
            <div class="flex flex-col items-center">
                <img :src="ban.image", class="h-16 w-auto rounded-md ring-2 bg-team-a/30 ring-team-a" />

                <span x-text="titleize(ban.name)"></span>
            </div>
        </template>

        <template x-for="ban in skillBans('team_b')">
            <div class="flex flex-col items-center">
                <img :src="ban.image", class="h-16 w-auto rounded-md ring-2 bg-team-b/30 ring-team-b" />

                <span x-text="titleize(ban.name)"></span>
            </div>
        </template>
    </div>
</div>