<%= simple_form_for DraftPick.new do |f| %>
    <%= f.hidden_field :draft_game_id, value: draft_game.id %>

    <%= render DraftGameModalComponent.new do |modal| %>
        <% modal.with_header do %>
            <div class="flex justify-between">
                <div>
                    Pick a heist to ban
                </div>

                <input x-model="heistSearch" placeholder="Search for a heist ..." />
            </div>
        <% end %>

        <div class="grid grid-cols-4 gap-4">
            <template x-for="heist in state.available_heists" :key="heist">
                <label
                    class="cursor-pointer border rounded-lg p-4 text-center"
                    :class="{ 'ring-2': selectedHeist == heist,
                        'ring-red-500': myTeam === 'team_a',
                        'ring-blue-500': myTeam === 'team_b'
                    }"
                    x-show="heist.toLowerCase().includes(heistSearch.toLowerCase())"
                >
                    <input
                        type="radio"
                        name="draft_pick[name]"
                        :value="heist"
                        x-model="selectedHeist"
                        class="hidden"
                    >

                    <span x-text="titleize(heist)"></span>
                </label>
            </template>
        </div>

        <% modal.with_footer do %>
            <%= f.submit 'Submit', class: "btn-primary w-full mt-4 cursor-pointer" %>
        <% end %>
    <% end %>
<% end %>