<div class="min-h-32 flex flex-col gap-4 w-full ring-2 ring-gray-800 bg-gray-700 p-4 rounded-md">
    <div class="text-center text-3xl">
        Weapon Category Bans
    </div>

    <div class="flex justify-between gap-4">
        <div class="flex flex-col gap-4">
            <template x-for="ban in weaponBans('team_a')">
                <div class="flex flex-col items-center">
                    <img :src="ban.image", class="h-24 rounded-md ring-2 ring-red-500" />

                    <span x-text="titleize(ban.name)"></span>
                </div>
            </template>
        </div>

        <div class="flex flex-col gap-4">
            <template x-for="ban in weaponBans('team_b')">
                <div class="flex flex-col items-center">
                    <img :src="ban.image", class="h-24 rounded-md ring-2 ring-blue-500" />

                    <span x-text="titleize(ban.name)"></span>
                </div>
            </template>
        </div>
    </div>
</div>