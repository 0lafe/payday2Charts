<div x-data='draftGameStreamer({
    draftGameId: "<%= @draft_game.public_key %>",
    initialState: <%= raw json_escape(@draft_game.client_state.to_json) %>,
})'
    class="min-h-16 w-full items-center border-t-2 border-[#186d98] bg-[#186d98]/40 p-2 font-[PaydayFont] tracking-wider">
    <div class="flex justify-center text-2xl" x-cloak x-show="state.stage !== 'draft_done'">
        Pick/Ban in progress ...
    </div>

    <div class="flex justify-between gap-4" x-cloak x-show="state.stage === 'draft_done'">
        <div class="flex justify-between gap-4">
            <template x-for="ban in heistBans('team_a')">
                <img :src="ban.image", class="w-12 h-12 rounded-md ring-2 ring-team-a" />
            </template>

            <template x-for="ban in heistBans('team_b')">
                <img :src="ban.image", class="w-12 h-12 rounded-md ring-2 ring-team-b" />
            </template>
        </div>

        <div class="flex justify-between gap-4">
            <template x-for="ban in perkdeckBans('team_a')">
                <div class="flex flex-col items-center">
                    <img :src="ban.image", class="h-12 w-auto rounded-md ring-2 bg-team-a/30 ring-team-a" />

                    <span x-text="titleize(ban.name)"></span>
                </div>
            </template>

            <template x-for="ban in perkdeckBans('team_b')">
                <div class="flex flex-col items-center">
                    <img :src="ban.image", class="h-12 w-auto rounded-md ring-2 bg-team-b/30 ring-team-b" />

                    <span x-text="titleize(ban.name)"></span>
                </div>
            </template>
        </div>

        <div class="flex justify-between gap-4">
            <template x-for="ban in skillBans('team_a')">
                <div class="flex flex-col items-center">
                    <img :src="ban.image", class="h-12 w-auto rounded-md ring-2 bg-team-a/30 ring-team-a" />

                    <span x-text="titleize(ban.name)"></span>
                </div>
            </template>

            <template x-for="ban in skillBans('team_b')">
                <div class="flex flex-col items-center">
                    <img :src="ban.image", class="h-12 w-auto rounded-md ring-2 bg-team-b/30 ring-team-b" />

                    <span x-text="titleize(ban.name)"></span>
                </div>
            </template>
        </div>

        <div class="flex justify-between gap-4">
            <template x-for="ban in weaponBans('team_a')">
                <div class="flex flex-col items-center">
                    <img :src="ban.image", class="h-12 rounded-md ring-2 bg-team-a/30 ring-team-a" />

                    <span x-text="titleize(ban.name)"></span>
                </div>
            </template>

            <template x-for="ban in weaponBans('team_b')">
                <div class="flex flex-col items-center">
                    <img :src="ban.image", class="h-12 rounded-md ring-2 bg-team-b/30 ring-team-b" />

                    <span x-text="titleize(ban.name)"></span>
                </div>
            </template>
        </div>
    </div>
</div>