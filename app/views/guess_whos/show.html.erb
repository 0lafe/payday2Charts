<div data-controller="guess-who-show" data-guess-who-show-game-type-value="<%= @guess_who.game_type %>">
  <div class="m-4 h-2/3">
    <div class="gap-4" style="display:grid;grid-template-columns: <%= ["weapon", "melee"].include?(@guess_who.game_type) ? "repeat(6, 1fr)" : "repeat(8, 1fr)" %>;">
      <% @guess_who.items.each do |item| %>
        <div>
          <div class="bg-dark-highlight border border-dark-light cursor-pointer rounded-md hover:scale-105 gameplay-item" data-action="click->guess-who-show#flip">
            <%= render "guess_whos/card", item: %>
          </div>
          <% if @guess_who.game_type == "content_creators" || @guess_who.game_type == "characters" %>
            <p style="color:white"><%= item.gsub(".png", "").gsub(".jpg", "").gsub(".PNG", "") %></p>
          <% elsif @guess_who.game_type == "skins" %>
            <p style="color:white"><%= GuessWho.skin_data(item)["name"] %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="h-px bg-white/10"></div>

  <div class="flex justify-between items-center m-auto w-2/3 mt-4">
    <h2>
      Your lobby code is <%= params[:id] %>
      <i data-action="click->guess-who-show#copyLink" class="fa-solid fa-clipboard copy-link" data-bs-toggle="tooltip" title="Copy" data-bs-placement="top" data-link="<%= "https://payday-charts.com/guess_whos/#{@guess_who.id}" %>"></i>
    </h2>

    <button class="btn btn-primary" data-action="click->guess-who-show#reset">
      Reset
    </button>

    <div class="flex justify-center flex-col items-center">
      <h2>Your Card:</h2>
      <div style="background:white;border-radius:0.5rem;">
        <% if ["heist", "content_creators"].include?(@guess_who.game_type) %>
          <img data-guess-who-show-target="yourCard" class="w-30 guess_who_card p-4" />
        <% elsif @guess_who.game_type == "skins" %>
          <img data-guess-who-show-target="yourCard" class="w-32 guess_who_card rarity-background"/>
        <% else %>
          <img data-guess-who-show-target="yourCard" class="w-32 guess_who_card"/>
        <% end %>
      </div>
    </div>
  </div>
</div>

