<div
    class="w-full max-w-4xl max-h-[calc(100vh-4rem)] rounded-2xl bg-gray-900 shadow-2xl flex flex-col"
    @click.stop
>
    <% if header %>
        <div class="shrink-0 border-b border-gray-800 p-4">
            <%= header %>
        </div>
    <% end %>

    <div class="flex-1 min-h-0 overflow-y-auto p-4">
        <%= content %>
    </div>

    <% if footer %>
        <div class="shrink-0 border-t border-gray-800 p-4">
            <%= footer %>
        </div>
    <% end %>
</div>